# Copy this file to .env (git-ignored) and fill in your own value. Never commit .env.
# Neon: Dashboard -> Connect -> copy the *pooled* connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Or for local container SQLite:
# DATABASE_URL=sqlite:////data/claims.db

# MLflow runs folder path (defaults to repo root / mlruns if omitted)
MLRUNS_DIR=/mlruns

# Set to true to allow feature drift (PSI status alert) to trigger model retrain
DRIFT_TRIGGERS_RETRAIN=false

# Port configurations for Docker Compose
BACKEND_PORT=8000
FRONTEND_PORT=3000
MLFLOW_PORT=5000

# Grafana Admin Credentials (placeholder values)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
